# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# MongoDB connection string
MONGODB_URI=

# Port the server listens on (optional; defaults to 5001)
PORT=5001

# development | production
NODE_ENV=development

# GitHub Personal Access Token for GitHub Models (fine-grained, "Models: read").
# Used for grammar correction (gpt-4o-mini). Keep this secret.
GITHUB_TOKEN=

# Google OAuth Web Client ID (from Google Cloud Console → Credentials).
# Must match the frontend's REACT_APP_GOOGLE_CLIENT_ID. Used to verify sign-ins.
GOOGLE_CLIENT_ID=

# Secret used to sign/verify app session JWTs. Use a long random string.
JWT_SECRET=
